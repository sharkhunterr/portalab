# Portalab — bootstrap settings ONLY (specs/001-portal-global-spec/contracts/bootstrap-settings.md).
# Every product/runtime setting is managed by Administration (spec 020), never by the environment.
# Secrets are passed through *_FILE variables pointing at mounted files — never inline values in Git.

# PostgreSQL connection (prefer the _FILE form; the file contains a full URL)
# DATABASE_URL=postgresql+asyncpg://portalab:CHANGE_ME@postgres:5432/portalab
DATABASE_URL_FILE=/run/secrets/portalab_database_url

# Application key used to encrypt stored credentials (file with >= 32 random bytes, e.g. `openssl rand -base64 48`)
SECRET_KEY_FILE=/run/secrets/portalab_secret_key

# HTTP listener
BIND_HOST=0.0.0.0
BIND_PORT=8080

# Blob storage root (avatars, exports) — mount a persistent volume here
DATA_DIR=/var/lib/portalab

# Bootstrap log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Used only by docker-compose for the postgres container
POSTGRES_DB=portalab
POSTGRES_USER=portalab
POSTGRES_PASSWORD_FILE=/run/secrets/portalab_db_password

# Plugins (spec 023): packages live under ${DATA_DIR}/plugins/{available,installed} (part of the data
# volume — keep it in backups). Enabling a plugin creates its own PostgreSQL schema and role, so the
# database user needs CREATEROLE (or the portal must run as the database owner). Plugin code and updates
# take effect after a graceful restart of both `serve` and `worker`.
