{
  "schemaVersion": 2,
  "key": "portalab-dark",
  "name": "Portalab (dark)",
  "family": "portalab",
  "colorScheme": "dark",
  "colors": {
    "surface": "#0b0e17",
    "surfaceRaised": "#161b2b",
    "text": "#eef1f8",
    "textMuted": "#a9b2c7",
    "border": "#2b3349",
    "accent": "#7f9cff",
    "accentContrast": "#0b0e17",
    "focus": "#a3b8ff",
    "accentAlt": "#ffb547",
    "rarity": {
      "common": "#b9c1d3",
      "rare": "#5cb4ff",
      "epic": "#c48dff",
      "legendary": "#ffb547"
    }
  },
  "states": {
    "loading": {
      "fg": "#d8dee9",
      "bg": "#1a2031",
      "icon": "spinner"
    },
    "available": {
      "fg": "#8fe0b0",
      "bg": "#10261c",
      "icon": "check"
    },
    "partial": {
      "fg": "#ffd08a",
      "bg": "#2c2210",
      "icon": "half"
    },
    "stale": {
      "fg": "#f2d27a",
      "bg": "#2a2312",
      "icon": "clock"
    },
    "error": {
      "fg": "#ffadb3",
      "bg": "#361318",
      "icon": "warning"
    },
    "unavailable": {
      "fg": "#f0b8c6",
      "bg": "#2b1820",
      "icon": "blocked"
    },
    "maintenance": {
      "fg": "#c9b6ff",
      "bg": "#21193a",
      "icon": "wrench"
    },
    "unauthorized": {
      "fg": "#f7b2d6",
      "bg": "#311424",
      "icon": "lock"
    },
    "no-data": {
      "fg": "#c4cad4",
      "bg": "#1b2130",
      "icon": "lines"
    },
    "syncing": {
      "fg": "#9ed2f5",
      "bg": "#10253a",
      "icon": "sync"
    }
  },
  "typography": {
    "fontFamily": "Inter Variable, system-ui, sans-serif"
  },
  "radii": {
    "sm": 0.5,
    "md": 1
  },
  "motion": {
    "fastMs": 140,
    "normalMs": 260,
    "profile": "lively",
    "celebration": "confetti"
  },
  "layout": {
    "nav": {
      "desktop": "sidebar",
      "tablet": "rail",
      "phone": "drawer"
    },
    "header": "full",
    "headerPosition": "top",
    "cards": "glass",
    "content": "wide",
    "corners": "round",
    "widgetFrame": "glass"
  },
  "icons": {
    "set": "outline"
  },
  "background": {
    "fallback": "#0b0e17"
  },
  "sounds": {
    "notification": "asset:portalab/notification.wav",
    "alert": "asset:portalab/alert.wav",
    "success": "asset:portalab/success.wav",
    "reward": "asset:portalab/reward.wav",
    "levelUp": "asset:portalab/level-up.wav",
    "ui": "asset:portalab/ui.wav"
  },
  "notification": {
    "position": "top-end",
    "durationSeconds": 6,
    "style": "toast"
  }
}
