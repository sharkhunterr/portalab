{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/*.mjs", "tests/fixtures/visual-probes/*.js"],
  "ignoreExportsUsedInFile": true,
  "ignore": ["src/api/generated/**"],
  "rules": {
    "duplicates": "off"
  },
  "playwright": {
    "config": ["playwright.config.ts", "playwright.nightly.config.ts"]
  }
}
