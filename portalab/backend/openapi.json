    "/api/v1/admin/transfer": {
      "post": {
        "operationId": "transfer_admin_api_v1_admin_transfer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminTransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "409": {
            "description": "admin.sole_admin_protected"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Transfer Admin",
        "tags": [
          "identity-admin"
        ]
      }
    },
    "/api/v1/auth/deletion/cancel": {
      "post": {
        "description": "Sign-in is refused during Pending Deletion, so the owner cancels by re-entering credentials.",
        "operationId": "cancel_deletion_with_credentials_api_v1_auth_deletion_cancel_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsConfirmation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "auth.invalid_credentials"
          },
          "403": {
            "description": "auth.account_unavailable"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Deletion With Credentials",
        "tags": [
          "identity"
        ]
      }
    },
