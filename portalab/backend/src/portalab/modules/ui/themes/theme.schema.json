      "properties": {
        "fontFamily": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9 ,\"'-]+$"
        },
        "scale": {
          "type": "object",
          "properties": {
            "sm": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1.25
            },
            "md": {
              "type": "number",
              "minimum": 0.875,
              "maximum": 1.5
            },
            "lg": {
              "type": "number",
              "maximum": 2.5
            },
            "xl": {
              "type": "number",
              "maximum": 3.5
            }
          },
          "required": [
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "radii": {
      "type": "object",
      "properties": {
        "sm": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "md": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "sm",
        "md"
      ],
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "fastMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "normalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      },
      "required": [
        "fastMs",
        "normalMs"
      ],
      "additionalProperties": false
    },
