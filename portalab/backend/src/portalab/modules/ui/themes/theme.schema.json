      "type": "object",
      "properties": {
        "set": {
          "type": "string",
          "enum": [
            "default",
            "outline"
          ]
        }
      },
      "required": [
        "set"
      ],
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^asset:[a-z0-9][a-z0-9._/-]{0,127}$"
            },
            {
              "type": "string",
              "maxLength": 200000,
              "pattern": "^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$"
            }
          ]
        },
        "fallback": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "fallback"
      ],
      "additionalProperties": false
    },
    "sounds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "notification",
          "alert",
          "success"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^asset:[a-z0-9][a-z0-9._/-]{0,127}$"
      },
      "required": [
        "notification",
        "alert",
        "success"
      ]
    },
    "notification": {
      "type": "object",
      "properties": {
        "position": {
          "type": "string",
          "enum": [
            "top-end",
            "top-start",
            "bottom-end",
            "bottom-start"
          ]
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 60
        },
        "style": {
          "type": "string",
          "enum": [
            "toast",
            "banner"
          ]
        }
      },
      "additionalProperties": false
    }
