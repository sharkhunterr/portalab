[
  {
    "name": "accueil-personnaliser",
    "page": "guide-accueil",
    "route": "/",
    "height": 1000,
    "settle": 25000,
    "before": [
      {
        "click": "[data-tour='customize']",
        "waitFor": {
          "en": ".widget-frame:has(.dash-grip[aria-label$='Continue']) .widget-frame__body img",
          "fr": ".widget-frame:has(.dash-grip[aria-label$='Reprendre']) .widget-frame__body img"
        },
        "wait": 2500
      },
      {
        "css": ".dashboard-toolbar a.ds-button{display:none!important}",
        "wait": 800
      }
    ],
    "clip": "main",
    "maxHeight": 640,
    "marks": [
      {
        "target": "[data-tour='add-widget']",
        "pad": 3
      },
      {
        "target": "[data-tour='dashboard-save']",
        "pad": 3
      },
      {
        "target": ".dashboard-toolbar fieldset",
        "pad": 3
      },
      {
        "target": ".dashboard-toolbar__mode",
        "pad": 3
      },
      {
        "target": ".dashboard-toolbar > button",
        "pad": 3
      },
      {
        "target": {
          "en": ".widget-frame:has(.dash-grip[aria-label$='Continue']) .widget-frame__controls",
          "fr": ".widget-frame:has(.dash-grip[aria-label$='Reprendre']) .widget-frame__controls"
        },
        "pad": 3
      },
      {
        "target": {
          "en": ".dash-grip[aria-label$='Continue']",
          "fr": ".dash-grip[aria-label$='Reprendre']"
        },
        "pad": 3
      },
      {
        "target": {
          "en": ".widget-frame:has(.dash-grip[aria-label$='Continue']) .dash-resize--corner",
          "fr": ".widget-frame:has(.dash-grip[aria-label$='Reprendre']) .dash-resize--corner"
        },
        "pad": 6
      }
    ]
  },
  {
    "name": "accueil-catalogue",
    "page": "guide-accueil",
    "route": "/",
    "height": 1000,
    "settle": 25000,
    "before": [
      {
        "click": "[data-tour='customize']",
        "waitFor": ".dashboard-toolbar",
        "wait": 2000
      },
      {
        "click": "[data-tour='add-widget']",
        "waitFor": ".widget-gallery__item",
        "wait": 3000
      }
    ],
    "clip": "[role='dialog']",
    "maxHeight": 390,
    "marks": [
      {
        "target": ".widget-catalog__search",
        "label": {
          "en": "Search for a widget",
          "fr": "Chercher un widget"
        },
        "side": "right",
        "gap": 40
      },
      {
        "target": ".widget-catalog .in-shop",
        "label": {
          "en": "More widgets in the shop",
          "fr": "D'autres widgets dans la boutique"
        },
        "side": "right",
        "gap": 40
      },
      {
        "target": ".widget-gallery__item:nth-child(3) .widget-gallery__preview",
        "label": {
          "en": "Its preview",
          "fr": "Son aperçu"
        },
        "side": "right",
        "gap": 40
      },
      {
        "target": ".widget-gallery__item:nth-child(3) .widget-gallery__text",
        "label": {
          "en": "What it does, and its possible sizes",
          "fr": "Ce qu'il fait, et ses tailles possibles"
        },
        "side": "right",
        "gap": 40
      },
      {
        "target": ".widget-gallery__item:nth-child(3) button",
        "label": {
          "en": "Add it to the dashboard",
          "fr": "L'ajouter au tableau de bord"
        },
        "side": "right",
        "gap": 40
      }
    ],
    "margin": [
      0,
      330,
      0,
      0
    ]
  },
  {
    "name": "accueil-reglages",
    "page": "guide-accueil",
    "route": "/",
    "height": 1000,
    "settle": 25000,
    "before": [
      {
        "click": "[data-tour='customize']",
        "waitFor": ".dashboard-toolbar",
        "wait": 2000
      },
      {
        "click": {
          "en": ".widget-frame:has(.dash-grip[aria-label$='Continue']) .dash-tool",
          "fr": ".widget-frame:has(.dash-grip[aria-label$='Reprendre']) .dash-tool"
        },
        "waitFor": "[role='dialog']",
        "wait": 2500
      }
    ],
    "clip": "[role='dialog']",
    "marks": [
      {
        "target": "[role='dialog'] select",
        "label": {
          "en": "An option of this widget's own",
          "fr": "Une option propre à ce widget"
        },
        "side": "left",
        "gap": 40
      },
      {
        "target": "[role='dialog'] select",
        "pick": "last",
        "label": {
          "en": "The widget's « Look »",
          "fr": "Le « Visuel » du widget"
        },
        "side": "right",
        "gap": 40
      },
      {
        "target": "[role='dialog'] fieldset",
        "label": {
          "en": "« Display », for every widget",
          "fr": "L'« Affichage », pour tous les widgets"
        },
        "side": "left",
        "gap": 40
      }
    ],
    "margin": [
      10,
      320,
      10,
      320
    ]
  },
  {
    "name": "accueil-acces-rapides",
    "page": "guide-accueil",
    "route": "/",
    "height": 1000,
    "settle": 20000,
    "before": [
      {
        "waitFor": ".widget-links li",
        "scroll": ".widget-frame:has(.widget-links)",
        "wait": 2000
      }
    ],
    "clip": ".widget-frame:has(.widget-links)",
    "margin": [
      16,
      16,
      16,
      16
    ],
    "marks": [
      {
        "target": ".widget-links li",
        "pad": 3
      },
      {
        "target": ".widget-links__dot",
        "pad": 3
      }
    ]
  }
]
