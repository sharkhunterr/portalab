[
  {
    "name": "cartes-mes-cartes",
    "page": "guide-cartes",
    "route": "/cards",
    "height": 900,
    "maxHeight": 760,
    "marks": [
      {
        "target": ".cards-summary",
        "pad": 3
      },
      {
        "target": ".cards-views:not(.cards-views--small)",
        "pad": 3
      },
      {
        "target": ".cards-search",
        "pad": 3
      },
      {
        "target": ".cards-views--small",
        "pad": 3
      },
      {
        "target": ".cards-sets li[data-started]",
        "label": {
          "en": "A set: its code and how far you are",
          "fr": "Une extension : son code et votre avancée"
        },
        "side": "right",
        "gap": 60
      }
    ],
    "before": [
      {
        "waitFor": ".cards-sets li",
        "wait": 1500
      }
    ]
  },
  {
    "name": "cartes-anatomie",
    "page": "guide-cartes",
    "route": "/cards",
    "height": 1200,
    "before": [
      {
        "click": ".cards-sets li[data-started] a",
        "waitFor": ".cards-binder"
      },
      {
        "click": ".cards-binder__slot:has(.mcard[data-kind='cast']:not([data-missing]))",
        "waitFor": ".cards-sheet"
      },
      {
        "css": ".cards-sheet{grid-template-columns:27rem!important;justify-content:center}.cards-sheet figure:not(:first-of-type),.cards-sheet figcaption,.cards-sheet~*{display:none!important}",
        "wait": 2500
      }
    ],
    "clip": ".cards-sheet figure:first-of-type .mcard",
    "margin": [
      24,
      330,
      24,
      330
    ],
    "marks": [
      {
        "target": ".cards-sheet figure:first-of-type .mcard__name",
        "label": {
          "en": "Its name",
          "fr": "Son nom"
        },
        "side": "left",
        "pad": 3
      },
      {
        "target": ".cards-sheet figure:first-of-type .mcard__genre",
        "label": {
          "en": "The title's genre, which gives its colour",
          "fr": "Le genre du titre, qui donne sa couleur"
        },
        "side": "right",
        "pad": 3
      },
      {
        "target": ".cards-sheet figure:first-of-type .mcard__art",
        "label": {
          "en": "The artwork: the character in a scene of the title",
          "fr": "L'illustration : le personnage sur une scène du titre"
        },
        "side": "left",
        "pad": 2
      },
      {
        "target": ".cards-sheet figure:first-of-type .mcard__strip",
        "label": {
          "en": "What the card is, and its edition's symbol",
          "fr": "Ce qu'est la carte, et le symbole de son édition"
        },
        "side": "right",
        "pad": 2
      },
      {
        "target": ".cards-sheet figure:first-of-type .mcard__lower",
        "label": {
          "en": "The title: its poster, who plays the part, its figures",
          "fr": "Le titre : son affiche, qui joue le rôle, ses chiffres"
        },
        "side": "left",
        "pad": 2
      },
      {
        "target": ".cards-sheet figure:first-of-type .mcard__foot",
        "label": {
          "en": "Its number and its rarity",
          "fr": "Son numéro et sa rareté"
        },
        "side": "right",
        "pad": 2
      }
    ]
  },
  {
    "name": "cartes-classeur",
    "page": "guide-cartes",
    "route": "/cards",
    "height": 900,
    "maxHeight": 660,
    "before": [
      {
        "click": ".cards-sets li[data-started] a",
        "waitFor": ".cards-binder",
        "wait": 3000
      }
    ],
    "marks": [
      {
        "target": "main h1"
      },
      {
        "target": ".cards-binder li:has(.mcard:not([data-missing]))",
        "label": {
          "en": "Yours: in colour",
          "fr": "À vous : en couleur"
        },
        "side": "bottom",
        "gap": 30
      },
      {
        "target": ".cards-binder li:has(.mcard[data-missing])",
        "pick": "last",
        "label": {
          "en": "Not yours yet: dimmed",
          "fr": "Pas encore à vous : grisée"
        },
        "side": "bottom",
        "gap": 30
      }
    ]
  },
  {
    "name": "cartes-versions",
    "page": "guide-cartes",
    "route": "/cards",
    "height": 1200,
    "before": [
      {
        "click": ".cards-sets li[data-started] a",
        "waitFor": ".cards-binder"
      },
      {
        "click": ".cards-binder__slot:has(.mcard:not([data-missing]))",
        "waitFor": ".cards-sheet",
        "wait": 2500
      }
    ],
    "clip": "[role='dialog']",
    "marks": [
      {
        "target": ".cards-sheet figure[data-owned]",
        "label": {
          "en": "A version you have, and how many",
          "fr": "Une version que vous avez, et combien"
        },
        "side": "bottom",
        "gap": 24
      },
      {
        "target": ".cards-sheet figure:not([data-owned])",
        "label": {
          "en": "A version to find",
          "fr": "Une version à trouver"
        },
        "side": "bottom",
        "gap": 24
      }
    ]
  },
  {
    "name": "cartes-fiche-titre",
    "page": "guide-cartes",
    "route": "/cards",
    "height": 1000,
    "before": [
      {
        "follow": ".cards-sets li[data-started] a",
        "rewrite": [
          [
            "/cards/sets/",
            "/media/"
          ]
        ]
      },
      {
        "waitFor": ".cards-work",
        "scroll": ".cards-work",
        "wait": 3000
      }
    ],
    "clip": ".cards-work",
    "margin": [
      6,
      24,
      24,
      24
    ],
    "marks": [
      {
        "target": ".cards-hand > ul",
        "pad": 2
      },
      {
        "target": ".cards-hand__turn"
      },
      {
        "target": ".cards-work__progress"
      },
      {
        "target": ".cards-work__rarities"
      },
      {
        "target": ".cards-work__copies"
      },
      {
        "target": ".cards-work__facts a"
      }
    ]
  },
  {
    "name": "cartes-boutique",
    "page": "guide-cartes",
    "route": "/marketplace?type=card_booster",
    "height": 1000,
    "settle": 6000,
    "clip": "main",
    "marks": [
      {
        "target": ".vitrine-grid .vitrine-tile",
        "label": {
          "en": "A card booster: its genre, its number of cards (×3), its price",
          "fr": "Un booster de cartes : son genre, son nombre de cartes (×3), son prix"
        },
        "side": "top",
        "shift": 220,
        "gap": 50
      }
    ]
  },
  {
    "name": "cartes-a-ouvrir",
    "page": "guide-cartes",
    "route": "/cards?vue=boosters",
    "height": 1000,
    "settle": 5000,
    "before": [
      {
        "waitFor": ".cards-boosters__pack",
        "wait": 2500
      }
    ],
    "maxHeight": 640,
    "marks": [
      {
        "target": ".cards-boosters__pack",
        "label": {
          "en": "A booster: tap it to open it",
          "fr": "Un booster : touchez-le pour l'ouvrir"
        },
        "side": "right",
        "gap": 40
      },
      {
        "target": ".cards-boosters__pile",
        "label": {
          "en": "Identical boosters: how many in the stack",
          "fr": "Des boosters identiques : combien dans la pile"
        },
        "side": "bottom",
        "gap": 30,
        "pad": 3
      }
    ]
  }
]
