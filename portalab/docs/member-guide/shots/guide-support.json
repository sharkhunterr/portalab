      },
      {
        "target": ".new-ticket > .ds-stack--row",
        "pad": 4
      },
      {
        "target": ".new-ticket > form",
        "pad": 4
      }
    ],
    "before": [
      {
        "waitFor": ".service-picker",
        "wait": 1500
      }
    ]
  },
  {
    "name": "support-avis",
    "page": "guide-support",
    "route": "/feedback",
    "height": 1000,
    "marks": [
      {
        "target": ".feedback-block:has(.feedback-requests)",
        "pad": 4
