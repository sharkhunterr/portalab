[
  {
    "name": "support-nouveau",
    "page": "guide-support",
    "route": "/support/new",
    "height": 1000,
    "marks": [
      {
        "target": ".new-ticket > .ds-field:nth-child(1)",
        "pad": 4
      },
      {
        "target": ".new-ticket > .ds-field:nth-child(2)",
        "pad": 4
      },
      {
        "target": ".service-picker",
        "pad": 4
      },
      {
        "target": ".new-ticket .ds-field:has(textarea)",
